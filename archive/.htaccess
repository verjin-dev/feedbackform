# Root protections. Apache only — if this app is served by nginx, the
# equivalent location blocks must be added to the site config instead, and
# these files provide no protection there.

# Local credentials and any stray dumps are never served.
<FilesMatch "^(config\.local\.php|.*\.(sql|sql\.gz|bak|log|md))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Directory listings disclose the whole file inventory.
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "same-origin"
</IfModule>

# Session cookies should not be readable from JavaScript, and should not travel
# over plain HTTP once TLS is in place.
<IfModule mod_php.c>
  php_value session.cookie_httponly 1
  php_value session.use_strict_mode 1
</IfModule>
# Uncomment once the site is served over HTTPS:
# <IfModule mod_php.c>
#   php_value session.cookie_secure 1
# </IfModule>
