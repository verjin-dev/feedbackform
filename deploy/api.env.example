# Copy to /etc/evaluation/api.env, chown root:evaluation, chmod 640.
#
# SECRET_KEY signs session cookies. Changing it signs everyone out, which is
# the intended way to revoke every session at once. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql+psycopg://evaluation:CHANGE_ME@127.0.0.1:5432/evaluation
SECRET_KEY=CHANGE_ME

# Eight hours: long enough for a working day, short enough that a shared
# machine in a lab does not stay signed in overnight.
ACCESS_TOKEN_TTL_MINUTES=480

# Same-origin deployment, so this is only a fallback. It must not list a
# different host than the one serving the app; see deploy/nginx.conf.
CORS_ORIGINS=["https://feedback.example.edu"]

# --- Outbound email --------------------------------------------------------
# "console" prints mail to the log and sends nothing. That is the default on
# purpose: a deployment that has not been configured should be visibly
# undelivered rather than silently mailing real students. Switch to "smtp"
# only once the settings below are right.
EMAIL_BACKEND=console
EMAIL_FROM=Faculty Evaluation <no-reply@example.edu>
# EMAIL_REPLY_TO=registrar@example.edu

SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# The address a recipient can actually open. Links in every email are built
# from this, so it is the app's public URL — not the API's.
APP_BASE_URL=https://feedback.example.edu

# Printed on accreditation exports. There is no institution record in the
# schema, so this is configuration.
INSTITUTION_NAME=Erode Sengunthar Engineering College

PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_HOURS=168

# --- College sign-in (optional) --------------------------------------------
#
# Leave these unset and the feature is off: the sign-in page shows the password
# form only, exactly as before. Password sign-in keeps working either way -- an
# identity-provider outage during an evaluation window must not lock the
# college out of its own feedback.
#
# Staff only. Students have no college directory account and are refused here
# even if one exists for their address.
#
# Google Workspace:
#   OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# Microsoft 365 (substitute the tenant id or domain):
#   OIDC_DISCOVERY_URL=https://login.microsoftonline.com/<tenant>/v2.0/.well-known/openid-configuration
#
# Register the redirect URI with the provider exactly as:
#   https://feedback.example.edu/api/auth/sso/callback
#
#OIDC_DISCOVERY_URL=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#
# Comma-separated. Both providers will happily authenticate a personal account;
# this is what makes it the college's directory rather than anyone's. Sign-in is
# off until at least one domain is listed.
#OIDC_ALLOWED_DOMAINS=example.edu
#
# Shown on the button. Name it the way staff would: "your ESEC staff account"
# lands better than "Microsoft".
#OIDC_BUTTON_LABEL=your college account
